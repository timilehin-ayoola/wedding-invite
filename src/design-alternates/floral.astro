---
/* Direction C — Romantic Floral.
   Cream and blush, sage accents, script headings, soft rounded cards. */
import Head from "../components/Head.astro";
import Countdown from "../components/Countdown.astro";
import Behaviours from "../components/Behaviours.astro";
import Sprig from "../components/Sprig.astro";
import { wedding } from "../data/wedding";
import "../styles/base.css";

const { couple, date, venue, hero, story, schedule, gallery, gift, faq, replies, footer, meta } =
  wedding;

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const whatsappShare = `https://wa.me/?text=${encodeURIComponent(`${footer.shareText} — ${shareUrl}`)}`;
const isExternal = /^https?:\/\//.test(gift.url);
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={meta.title}
      description={meta.description}
      noindex={meta.noindex}
      themeColor="#FFFBF7"
      fonts="family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Great+Vibes&family=Karla:wght@400;500;600"
    />
  </head>

  <body class="floral">
    <a class="skip-link" href="#main">Skip to the invitation</a>

    <main id="main">
      <!-- ------------------------------------------------------------ hero -->
      <header class="hero" data-reveal>
        <div class="hero__card">
          <p class="hero__kicker">{hero.kicker}</p>
          <h1 class="hero__names">
            <span class="hero__name">{couple.partnerOne}</span>
            <span class="hero__amp" aria-hidden="true">&amp;</span>
            <span class="hero__name">{couple.partnerTwo}</span>
          </h1>
          <Sprig />
          <p class="hero__invitation">{hero.invitation}</p>
          <p class="hero__date">
            <time datetime={date.iso}>{date.long}</time>
          </p>
          <p class="hero__venue">{venue.name} · {venue.addressLines.slice(-1)[0]}</p>
          <p class="hero__tagline">{hero.tagline}</p>

          <Countdown class="countdown--floral" />

          <div class="hero__actions">
            <a class="btn btn--sage" href="/wedding.ics" download>Add to calendar</a>
            <a class="btn btn--outline" href={whatsappShare} target="_blank" rel="noopener noreferrer">
              Share this invite
            </a>
          </div>
        </div>
      </header>

      <!-- ----------------------------------------------------------- story -->
      <section class="section" aria-labelledby="story-heading" data-reveal>
        <p class="section__eyebrow">Our story</p>
        <h2 class="section__title" id="story-heading">{story.heading}</h2>
        <Sprig />
        <p class="lede">{story.intro}</p>
        {story.paragraphs.map((paragraph) => <p class="body-text">{paragraph}</p>)}

        <ol class="milestones">
          {story.milestones.map((milestone) => (
            <li class="milestone">
              <span class="milestone__year">{milestone.year}</span>
              <h3 class="milestone__title">{milestone.title}</h3>
              <p class="milestone__text">{milestone.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- --------------------------------------------------------- the day -->
      <section class="section" aria-labelledby="day-heading" data-reveal>
        <p class="section__eyebrow">Schedule</p>
        <h2 class="section__title" id="day-heading">The celebration</h2>
        <Sprig />
        <p class="lede">
          {date.timezoneLabel}
        </p>
        <ol class="schedule">
          {schedule.map((item) => (
            <li class="schedule__item">
              <span class="schedule__time">{item.time}</span>
              <div class="schedule__body">
                <h3 class="schedule__title">{item.title}</h3>
                <p class="schedule__detail">{item.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ----------------------------------------------------------- venue -->
      <section class="section" aria-labelledby="venue-heading" data-reveal>
        <p class="section__eyebrow">Where</p>
        <h2 class="section__title" id="venue-heading">The venue</h2>
        <Sprig />
        <div class="venue card">
          <h3 class="venue__name">{venue.name}</h3>
          <address class="venue__address">
            {venue.addressLines.map((line) => <span>{line}</span>)}
          </address>
          <p class="body-text">{venue.directions}</p>
          <a class="btn btn--sage" href={venue.mapUrl} target="_blank" rel="noopener noreferrer">
            {venue.mapLabel}
          </a>
        </div>
      </section>

      <!-- --------------------------------------------------------- gallery -->
      <section class="section" aria-labelledby="gallery-heading" data-reveal>
        <p class="section__eyebrow">Memories</p>
        <h2 class="section__title" id="gallery-heading">{gallery.heading}</h2>
        <Sprig />
        <p class="lede">{gallery.intro}</p>
        <ul class="gallery">
          {gallery.photos.map((photo) => (
            <li class:list={["gallery__item", `gallery__item--${photo.shape ?? "wide"}`]}>
              <figure>
                <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                {photo.caption && <figcaption>{photo.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </section>

      <!-- ------------------------------------------------------------ gift -->
      <section class="section section--gift" aria-labelledby="gift-heading" data-reveal>
        <div class="gift card">
          <p class="section__eyebrow">With love</p>
          <h2 class="section__title section__title--script" id="gift-heading">{gift.heading}</h2>
          <p class="lede">{gift.message}</p>
          <p class="gift__note">{gift.note}</p>
          <a
            class="btn btn--sage btn--wide"
            href={gift.url}
            data-gift-link
            {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {gift.ctaLabel}
            {isExternal && <span class="sr-only"> ({gift.urlLabel})</span>}
          </a>
          <ul class="gift__alternatives">
            {gift.alternatives.map((option) => (
              <li>
                <strong>{option.label}</strong>
                <span>{option.detail}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ------------------------------------------------------------- faq -->
      <section class="section" aria-labelledby="faq-heading" data-reveal>
        <p class="section__eyebrow">Details</p>
        <h2 class="section__title" id="faq-heading">{faq.heading}</h2>
        <Sprig />
        <div class="faq">
          {faq.items.map((item) => (
            <details class="faq__item">
              <summary>
                <span>{item.q}</span>
                <span class="faq__marker" aria-hidden="true"></span>
              </summary>
              <p class="body-text">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- --------------------------------------------------------- replies -->
      <section class="section" aria-labelledby="replies-heading" data-reveal>
        <p class="section__eyebrow">RSVP</p>
        <h2 class="section__title" id="replies-heading">{replies.heading}</h2>
        <Sprig />
        <p class="lede">{replies.text}</p>
        <ul class="replies">
          {replies.contacts.map((contact) => (
            <li class="replies__item">
              <span class="replies__name">{contact.name}</span>
              <span class="replies__channel">{contact.channel}</span>
              <span class="replies__value">{contact.value}</span>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="footer" data-reveal>
      <Sprig />
      <p class="footer__closing">{footer.closing}</p>
      <p class="footer__signature">{footer.signature}</p>
      <p class="footer__hashtag">{couple.hashtag}</p>
      <div class="footer__actions">
        <a class="btn btn--cream" href={whatsappShare} target="_blank" rel="noopener noreferrer">
          Share on WhatsApp
        </a>
        <button class="btn btn--cream-outline" type="button" data-share data-share-text={footer.shareText}>
          Copy invite link
        </button>
      </div>
      <p class="footer__small">
        For family and friends. Gift giving is entirely optional.
      </p>
    </footer>

    <Behaviours />
  </body>
</html>

<style is:global>
  .floral {
    --cream: #fffbf7;
    --blush: #f8e6de;
    --sage: #5f6d54;
    --sage-deep: #4f5b43;
    --clay: #9e5540;
    --plum: #47353c;
    --muted: #6f5f64;
    --line: #ead9d0;

    background: var(--cream);
    color: var(--plum);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.12rem;
    line-height: 1.75;
    background-image: radial-gradient(circle at 85% 4%, rgba(248, 230, 222, 0.9), transparent 38%),
      radial-gradient(circle at 6% 52%, rgba(124, 139, 111, 0.08), transparent 34%);
    background-repeat: no-repeat;
    background-attachment: fixed;
  }

  .floral h1, .floral h2, .floral h3 { font-weight: 500; line-height: 1.25; }

  .floral .section__eyebrow {
    font-family: "Karla", system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 0.7rem;
    color: var(--clay);
    text-align: center;
  }
  .floral :focus-visible { outline-color: var(--sage-deep); }

  /* ---------------------------------------------------------------- hero -- */
  .floral .hero {
    padding: clamp(1.25rem, 4vw, 3.5rem) clamp(0.9rem, 3vw, 2rem) clamp(2rem, 6vw, 4rem);
    display: grid;
    place-items: center;
    min-height: 100svh;
  }
  .floral .hero__card {
    width: min(100%, 44rem);
    text-align: center;
    background: linear-gradient(180deg, #ffffff 0%, #fdf3ee 100%);
    border: 1px solid var(--line);
    border-radius: 2.25rem;
    padding: clamp(2.25rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 3.5rem);
    box-shadow: 0 34px 70px -50px rgba(71, 53, 60, 0.45);
  }
  .floral .hero__kicker {
    font-family: "Karla", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 0.72rem;
    color: var(--sage-deep);
  }
  .floral .hero__names {
    margin-top: 1.25rem;
    font-family: "Great Vibes", "Cormorant Garamond", cursive;
    font-weight: 400;
    font-size: clamp(3.1rem, 12vw, 6rem);
    color: var(--plum);
    display: grid;
    justify-items: center;
    gap: 0.05em;
    line-height: 1.05;
  }
  .floral .hero__amp {
    font-family: "Cormorant Garamond", serif;
    font-size: 0.3em;
    color: var(--clay);
  }
  .floral .hero__invitation {
    font-family: "Karla", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .floral .hero__date { margin-top: 1rem; font-size: clamp(1.25rem, 4vw, 1.7rem); color: var(--plum); }
  .floral .hero__venue {
    margin-top: 0.35rem;
    font-family: "Karla", sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .floral .hero__tagline { margin-top: 1.4rem; font-style: italic; color: #5d4c52; }
  .floral .hero__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  /* ----------------------------------------------------------- countdown -- */
  .floral .countdown { margin-top: 2.25rem; }
  .floral .countdown__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    max-width: 24rem;
    margin: 0 auto;
  }
  .floral .countdown__unit {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    padding: 0.9rem 0.25rem;
  }
  .floral .countdown__value {
    display: block;
    font-size: clamp(1.4rem, 5vw, 2rem);
    color: var(--sage-deep);
    font-variant-numeric: tabular-nums;
  }
  .floral .countdown__name {
    display: block;
    margin-top: 0.15rem;
    font-family: "Karla", sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .floral .countdown__label { margin-top: 1rem; font-style: italic; color: var(--muted); }

  /* ------------------------------------------------------------- sections -- */
  .floral .section {
    width: min(100% - 2.25rem, 42rem);
    margin: clamp(3.25rem, 10vw, 6.5rem) auto;
    text-align: center;
  }
  .floral .section__title {
    font-size: clamp(2rem, 6vw, 2.9rem);
    margin-top: 0.35rem;
    color: var(--plum);
  }
  .floral .section__title--script { font-family: "Great Vibes", cursive; font-size: clamp(2.4rem, 8vw, 3.6rem); }
  .floral .lede { font-size: 1.15rem; color: #5d4c52; margin-bottom: 1.25rem; }
  .floral .body-text { color: #6a5a60; margin-bottom: 1rem; text-align: center; }
  .floral .card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 1.75rem;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    box-shadow: 0 24px 50px -44px rgba(71, 53, 60, 0.5);
  }

  /* ------------------------------------------------------------- milestones */
  .floral .milestones {
    margin-top: 2.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
    text-align: left;
  }
  .floral .milestone {
    background: #fffdfb;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    padding: 1.25rem 1.35rem;
  }
  .floral .milestone__year {
    font-family: "Karla", sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    background: var(--clay);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    display: inline-block;
  }
  .floral .milestone__title { margin-top: 0.75rem; font-size: 1.3rem; color: var(--plum); }
  .floral .milestone__text { font-size: 1rem; color: var(--muted); margin-top: 0.25rem; }

  /* ------------------------------------------------------------- schedule -- */
  .floral .schedule { margin-top: 2rem; text-align: left; position: relative; }
  .floral .schedule::before {
    content: "";
    position: absolute;
    left: 3.15rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: repeating-linear-gradient(to bottom, var(--line) 0 6px, transparent 6px 12px);
  }
  .floral .schedule__item {
    display: grid;
    grid-template-columns: 4.75rem 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    position: relative;
  }
  .floral .schedule__time {
    font-family: "Karla", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--sage-deep);
    background: #f4f1ea;
    border-radius: 999px;
    padding: 0.35rem 0.6rem;
    height: fit-content;
    text-align: center;
    white-space: nowrap;
  }
  .floral .schedule__title { font-size: 1.25rem; color: var(--plum); }
  .floral .schedule__detail { font-size: 1rem; color: var(--muted); }

  /* --------------------------------------------------------------- venue -- */
  .floral .venue { display: grid; gap: 0.65rem; justify-items: center; }
  .floral .venue__name { font-size: clamp(1.5rem, 5vw, 2rem); color: var(--plum); }
  .floral .venue__address {
    font-style: normal;
    font-family: "Karla", sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    display: grid;
    gap: 0.2rem;
  }
  .floral .venue .body-text { margin-top: 0.5rem; }

  /* ------------------------------------------------------------- gallery -- */
  .floral .gallery {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  @media (min-width: 46rem) { .floral .gallery { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; } }
  .floral .gallery__item figure { margin: 0; }
  .floral .gallery__item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 1.5rem;
    border: 1px solid var(--line);
  }
  .floral .gallery__item--tall img { aspect-ratio: 3 / 4; }
  .floral .gallery__item figcaption {
    margin-top: 0.5rem;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* ---------------------------------------------------------------- gift -- */
  .floral .section--gift { width: min(100% - 2.25rem, 44rem); }
  .floral .gift {
    display: grid;
    gap: 1rem;
    justify-items: center;
    background: linear-gradient(180deg, #ffffff 0%, #faf1ec 100%);
    border: 1px solid var(--line);
    border-radius: 2rem;
    padding: clamp(1.75rem, 6vw, 3.25rem);
  }
  .floral .gift__note {
    font-style: italic;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
    width: 100%;
    max-width: 34rem;
  }
  .floral .gift__alternatives {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.6rem;
    font-size: 1rem;
    color: var(--muted);
    text-align: left;
  }
  .floral .gift__alternatives strong { color: var(--plum); font-weight: 600; margin-right: 0.35rem; }
  .floral .btn--wide { min-width: min(100%, 20rem); }

  /* ------------------------------------------------------------------ faq -- */
  .floral .faq { margin-top: 1.75rem; display: grid; gap: 0.75rem; text-align: left; }
  .floral .faq__item {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    padding: 0.25rem 1.35rem;
  }
  .floral .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-size: 1.2rem;
    color: var(--plum);
    list-style: none;
  }
  .floral .faq__marker {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    position: relative;
    background: var(--cream);
  }
  .floral .faq__marker::before,
  .floral .faq__marker::after {
    content: "";
    position: absolute;
    inset: 50% 25% auto 25%;
    height: 1px;
    background: var(--sage-deep);
    transition: transform 0.25s ease;
  }
  .floral .faq__marker::after { transform: rotate(90deg); }
  .floral .faq__item[open] .faq__marker::after { transform: rotate(0deg); }
  .floral .faq__item .body-text { text-align: left; padding-bottom: 1rem; }

  /* -------------------------------------------------------------- replies -- */
  .floral .replies {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.85rem;
  }
  .floral .replies__item {
    display: grid;
    gap: 0.2rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    padding: 1.1rem 1.35rem;
  }
  .floral .replies__name { font-size: 1.25rem; color: var(--plum); }
  .floral .replies__channel {
    font-family: "Karla", sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .floral .replies__value { font-size: 1.1rem; color: var(--muted); }

  /* --------------------------------------------------------------- footer -- */
  .floral .footer {
    background: var(--sage-deep);
    color: #f6f2e9;
    text-align: center;
    padding: clamp(2.5rem, 8vw, 4.5rem) 1.25rem clamp(2.25rem, 6vw, 3.5rem);
    margin-top: clamp(2rem, 6vw, 4rem);
  }
  .floral .footer .sprig { color: #cfd6c4; margin-top: 0; }
  .floral .footer__closing { font-family: "Great Vibes", cursive; font-size: clamp(2rem, 7vw, 3rem); }
  .floral .footer__signature { margin-top: 0.75rem; font-style: italic; color: #dfe4d6; }
  .floral .footer__hashtag {
    margin-top: 0.5rem;
    font-family: "Karla", sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #d3dac6;
  }
  .floral .footer__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .floral .footer__small { margin-top: 2rem; font-size: 0.85rem; color: #d3dac6; }
  .floral .footer :focus-visible { outline-color: #f6f2e9; }

  /* -------------------------------------------------------------- buttons -- */
  .floral .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.8rem 1.9rem;
    border-radius: 999px;
    font-family: "Karla", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .floral .btn--sage { background: var(--sage); color: #ffffff; }
  .floral .btn--sage:hover { background: var(--sage-deep); }
  .floral .btn--outline { border-color: var(--sage); color: var(--sage-deep); background: transparent; }
  .floral .btn--outline:hover { background: rgba(95, 109, 84, 0.12); }
  .floral .btn--cream { background: #f6f2e9; color: var(--sage-deep); }
  .floral .btn--cream:hover { background: #ffffff; }
  .floral .btn--cream-outline { border-color: #cfd6c4; color: #f6f2e9; }
  .floral .btn--cream-outline:hover { background: rgba(246, 242, 233, 0.14); }
</style>
